# === Twelve Data ===
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# === Database ===
DATABASE_URL=postgresql://forex_user:CHANGE_ME@localhost:5432/forex_signals

# === Admin bootstrap ===
# On first startup, the backend creates this account in BOTH Firebase Authentication
# and PostgreSQL (role=admin) if it doesn't already exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_strong_password
ADMIN_API_KEY=CHANGE_ME_random_key_for_admin_endpoints

# === Firebase Authentication + Cloud Messaging ===
# 1. Firebase Console -> Project settings -> Service accounts -> Generate new private key.
#    Save the JSON file and point this at its path (mount as a secret in prod, never commit it).
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json

# 2. Firebase Console -> Project settings -> General -> "Web API Key".
#    This is the same key used in any Firebase web/mobile app config (not the service
#    account secret) — required for the /auth/login and /auth/refresh endpoints, which
#    validate email/password via Firebase's Identity Toolkit REST API.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# === App ===
ENVIRONMENT=production
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000
SIGNAL_POLL_INTERVAL_SECONDS=300
MIN_RISK_REWARD_RATIO=2.0
MIN_CONFIDENCE_TO_PUBLISH=65
RATE_LIMIT_PER_MINUTE=60
